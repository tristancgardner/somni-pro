// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL") // Using the Neon PostgreSQL connection string
}

// Models for various settings types

model User {
  id                String               @id @default(uuid())
  email             String               @unique
  name              String?
  image             String?
  accountSettings   AccountSettings?
  billingSettings   BillingSettings?
  displaySettings   DisplaySettings?
  notificationSettings NotificationSettings?
  securitySettings  SecuritySettings?
}

model AccountSettings {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language     String?  @default("en")
  timezone     String?  @default("UTC")
  autoSave     Boolean  @default(true)
  soundEffects Boolean  @default(true)
  bio          String?  @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BillingSettings {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  autoReload       Boolean  @default(false)
  reloadAmount     Float?
  paymentMethod    String?
  billingEmail     String?
  billingAddress   String?
  creditLimit      Float?   @default(0)
  subscriptionTier String?  @default("free")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model DisplaySettings {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme        String?  @default("system")
  fontSize     String?  @default("medium")
  colorMode    String?  @default("default")
  reducedMotion Boolean  @default(false)
  highContrast  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model NotificationSettings {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      Boolean  @default(true)
  push       Boolean  @default(true)
  marketing  Boolean  @default(false)
  updates    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SecuritySettings {
  userId               String   @id
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  twoFactorEnabled     Boolean  @default(false)
  loginNotifications   Boolean  @default(true)
  sessionTimeout       Int?     @default(30) // in minutes
  rememberDevice       Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
