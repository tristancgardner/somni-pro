{
    "workbench.editor.customLabels.patterns": {
        "**/index**": "${dirname}/index.${extname}"
    },
    "folder-color.pathColors": [
        {
            "folderPath": "somni-pro/app/file-viewer/",
            "color": "foldercolorizer.color_00cc00",
            "badge": "fv"
        },
        {
            "folderPath": "somni-pro/app/transcription-viewer/",
            "color": "foldercolorizer.color_00cc00",
            "badge": "tv"
        },
        {
            "folderPath": "somni-pro/app/api/agents/identify-speakers/",
            "color": "foldercolorizer.color_00cc00"
        },
        {
            "folderPath": "somni-pro/components/agents/IdentifySpeakersAgent.tsx/",
            "color": "foldercolorizer.color_00cc33",
            "badge": "IS"
        },
        {
            "folderPath": "somni-pro/app/",
            "badge": "AP"
        },
        {
            "folderPath": "somni-pro/app/upload-audio/",
            "color": "foldercolorizer.color_cccc00"
        },
        {
            "folderPath": "somni-pro/app/api/agents/",
            "color": "foldercolorizer.color_00cc00"
        }
    ],
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        ".eslintrc.json": true,
        ".gitignore": true,
        "cleanup-db.js": true,
        "cleanup-orphaned-file.js": true,
        "components.json": true,
        "next-env.d.ts": true,
        "next.config.js": true,
        "next.config.mjs": true,
        "package-lock.json": true,
        "package.json": true,
        "postcss.config.mjs": true,
        "tailwind.config.ts": true,
        "tsconfig.json": true,
        "node_modules": true
    },
    "hide-files.files": [
        ".eslintrc.json",
        ".gitignore",
        "cleanup-db.js",
        "cleanup-orphaned-file.js",
        "components.json",
        "next-env.d.ts",
        "next.config.js",
        "next.config.mjs",
        "package-lock.json",
        "package.json",
        "postcss.config.mjs",
        "tailwind.config.ts",
        "tsconfig.json",
        "node_modules"
    ]
}
