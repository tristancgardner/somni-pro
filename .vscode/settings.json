{
    "workbench.editor.customLabels.patterns": {
        "**/index**": "${dirname}/index.${extname}"
    },
    "hide-files.files": [
        "components.json",
        "next-env.d.ts",
        "next.config.js",
        "next.config.mjs",
        "package-lock.json",
        "package.json",
        "postcss.config.mjs",
        "tailwind.config.ts",
        "tsconfig.json",
        ".eslintrc.json"
    ],
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "components.json": true,
        "next-env.d.ts": true,
        "next.config.js": true,
        "next.config.mjs": true,
        "package-lock.json": true,
        "package.json": true,
        "postcss.config.mjs": true,
        "tailwind.config.ts": true,
        "tsconfig.json": true,
        ".eslintrc.json": true
    }
}
